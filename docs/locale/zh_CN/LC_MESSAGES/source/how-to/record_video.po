msgid "Example 1: Kit viewport"
msgstr "示例 1：Kit 视口"

#: source/how-to/record_video.rst:103
msgid "Records the Kit interactive viewport (RTX renderer)"
msgstr "录制 Kit 交互视口（RTX 渲染器）"

#: source/how-to/record_video.rst:104
msgid "Shows 4 parallel environments"
msgstr "显示 4 个并行环境"

