msgid ":class:`~isaaclab.actuators.IdealPDActuatorCfg`"
msgstr ":class:`~isaaclab.actuators.IdealPDActuatorCfg`"

#: source/concepts/actuators.rst:693
msgid "``NewtonPDControlAPI`` + ``NewtonMaxEffortClampingAPI``"
msgstr "``NewtonPDControlAPI`` + ``NewtonMaxEffortClampingAPI``"

#: source/concepts/actuators.rst:694
msgid ":class:`~isaaclab.actuators.DCMotorCfg`"
msgstr ":class:`~isaaclab.actuators.DCMotorCfg`"

#: source/concepts/actuators.rst:695
msgid "``NewtonPDControlAPI`` + ``NewtonDCMotorClampingAPI``"
msgstr "``NewtonPDControlAPI`` + ``NewtonDCMotorClampingAPI``"

#: source/concepts/actuators.rst:696
msgid ":class:`~isaaclab.actuators.DelayedPDActuatorCfg`"
msgstr ":class:`~isaaclab.actuators.DelayedPDActuatorCfg`"

#: source/concepts/actuators.rst:697
msgid "ideal PD + ``NewtonActuatorDelayAPI``"
msgstr "理想 PD + ``NewtonActuatorDelayAPI``"

#: source/concepts/actuators.rst:698
msgid ":class:`~isaaclab.actuators.RemotizedPDActuatorCfg`"
msgstr ":class:`~isaaclab.actuators.RemotizedPDActuatorCfg`"

