#: source/concepts/deformables.rst:26
msgid "Soft solids: rubber blocks, teddy bears, organs"
msgstr "软质实体：橡胶块、泰迪熊、器官"

#: source/concepts/deformables.rst:27
msgid "Cloth, sheets, membranes"
msgstr "布料、薄片、膜"

#: source/concepts/deformables.rst:28
msgid "Ropes, hoses, wires, harnesses"
msgstr "绳索、软管、电线、线束"

#: source/concepts/deformables.rst:29
msgid "Simulated geometry"
msgstr "仿真几何体"

#: source/concepts/deformables.rst:30
msgid "Tetrahedral mesh (``UsdGeom.TetMesh``)"
msgstr "四面体网格（ ``UsdGeom.TetMesh`` ）"

#: source/concepts/deformables.rst:31
