msgid "``\"joint\"`` — number of selected joints from ``asset_cfg``"
msgstr "``\"joint\"`` — ``asset_cfg`` 中所选关节的数量"

#: source/concepts/warp_environments.rst:466
msgid "``\"body:N\"`` — N components per selected body from ``asset_cfg``"
msgstr "``\"body:N\"`` — ``asset_cfg`` 中每个所选刚体的 N 个分量"

#: source/concepts/warp_environments.rst:467
msgid "``\"command\"`` — dimension from command manager"
msgstr "``\"command\"`` — 从指令管理器获取维度"

#: source/concepts/warp_environments.rst:468
msgid "``\"action\"`` — dimension from action manager"
