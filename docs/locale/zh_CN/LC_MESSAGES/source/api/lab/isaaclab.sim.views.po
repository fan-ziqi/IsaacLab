#: isaaclab.sim.views.xform_prim_view.XformPrimView.__init__:3 of
msgid ""
"This method searches the USD stage for all prims matching the provided "
"path pattern, validates that they are Xformable with standard transform "
"operations, and stores references for efficient batch operations."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.__init__:7 of
#, python-format
msgid ""
"We generally recommend to validate the xform operations, as it ensures "
"that the prims are in a consistent state and have the standard transform "
"operations (translate, orient, scale in that order). However, if you are "
"sure that the prims are in a consistent state, you can set this to False "
"to improve performance. This can save around 45-50% of the time taken to "
"initialize the view."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.__init__
#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_local_poses
#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_scales
#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_visibility
#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_world_poses
#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_local_poses
#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_scales
#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_visibility
#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_world_poses of
msgid "Parameters"
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.__init__:12 of
msgid ""
"USD prim path pattern to match prims. Supports wildcards (``*``) and "
"regex patterns (e.g., ``\"/World/Env_.*/Robot\"``). See "
":func:`isaaclab.sim.utils.find_matching_prims` for pattern syntax."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.__init__:15 of
msgid ""
"Device to place the tensors on. Can be ``\"cpu\"`` or CUDA devices like "
"``\"cuda:0\"``. Defaults to ``\"cpu\"``."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.__init__:17 of
msgid ""
"Whether to validate that the prims have standard xform operations. "
"Defaults to True."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.__init__:19 of
msgid ""
"USD stage to search for prims. Defaults to None, in which case the "
"current active stage from the simulation context is used."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.__init__
#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_local_poses
#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_scales
#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_visibility
#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_world_poses of
msgid "Raises"
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.__init__:22 of
msgid ""
"If any matched prim is not Xformable or doesn't have standardized     "
"transform operations (translate, orient, scale in that order)."
msgstr ""

#: isaaclab.sim.views.XformPrimView.count
#: isaaclab.sim.views.XformPrimView.prim_paths
#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_local_poses
#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_scales
#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_visibility
#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_world_poses of
msgid "Returns"
msgstr ""

#: isaaclab.sim.views.XformPrimView.count:3 of
msgid "The number of prims being managed by this view."
msgstr ""

#: isaaclab.sim.views.XformPrimView.prim_paths:3 of
msgid ""
"This property converts each prim to its path string representation. The "
"conversion is performed lazily on first access and cached for subsequent "
"accesses."
msgstr ""

#: isaaclab.sim.views.XformPrimView.prim_paths:8 of
msgid ""
"For most use cases, prefer using :attr:`prims` directly as it provides "
"direct access to the USD prim objects without the conversion overhead. "
"This property is mainly useful for logging, debugging, or when string "
"paths are explicitly required."
msgstr ""

#: isaaclab.sim.views.XformPrimView.prim_paths:12 of
msgid "List of prim paths (as strings) in the same order as :attr:`prims`."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_world_poses:3 of
msgid ""
"This method sets the position and/or orientation of each prim in world "
"space. The world pose is computed by considering the prim's parent "
"transforms. If a prim has a parent, this method will convert the world "
"pose to the appropriate local pose before setting it."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_local_poses:7
#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_world_poses:7 of
msgid ""
"This operation writes to USD at the default time code. Any animation data"
" will not be affected."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_world_poses:9 of
msgid ""
"World-space positions as a tensor of shape (M, 3) where M is the number "
"of prims to set (either all prims if indices is None, or the number of "
"indices provided). Defaults to None, in which case positions are not "
"modified."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_world_poses:12 of
msgid ""
"World-space orientations as quaternions (w, x, y, z) with shape (M, 4). "
"Defaults to None, in which case orientations are not modified."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_local_poses:14
#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_world_poses:14 of
msgid ""
"Indices of prims to set poses for. Defaults to None, in which case poses "
"are set for all prims in the view."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_world_poses:17 of
msgid "If positions shape is not (M, 3) or orientations shape is not (M, 4)."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_local_poses:18
#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_world_poses:18 of
msgid "If the number of poses doesn't match the number of indices provided."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_local_poses:3 of
msgid ""
"This method sets the position and/or orientation of each prim in local "
"space (relative to their parent prims). This is useful when you want to "
"directly manipulate the prim's transform attributes without considering "
"the parent hierarchy."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_local_poses:9 of
msgid ""
"Local-space translations as a tensor of shape (M, 3) where M is the "
"number of prims to set (either all prims if indices is None, or the "
"number of indices provided). Defaults to None, in which case translations"
" are not modified."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_local_poses:12 of
msgid ""
"Local-space orientations as quaternions (w, x, y, z) with shape (M, 4). "
"Defaults to None, in which case orientations are not modified."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_local_poses:17 of
msgid "If translations shape is not (M, 3) or orientations shape is not (M, 4)."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_scales:3 of
msgid "This method sets the scale of each prim in the view."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_scales:5 of
msgid ""
"Scales as a tensor of shape (M, 3) where M is the number of prims to set "
"(either all prims if indices is None, or the number of indices provided)."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_scales:7 of
msgid ""
"Indices of prims to set scales for. Defaults to None, in which case "
"scales are set for all prims in the view."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_scales:10 of
msgid "If scales shape is not (M, 3)."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_visibility:3 of
msgid "This method sets the visibility of each prim in the view."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_visibility:5 of
msgid ""
"Visibility as a boolean tensor of shape (M,) where M is the number of "
"prims to set (either all prims if indices is None, or the number of "
"indices provided)."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_visibility:7 of
msgid ""
"Indices of prims to set visibility for. Defaults to None, in which case "
"visibility is set for all prims in the view."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.set_visibility:10 of
msgid "If visibility shape is not (M,)."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_world_poses:3 of
msgid ""
"This method retrieves the position and orientation of each prim in world "
"space by computing the full transform hierarchy from the prim to the "
"world root."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_world_poses:6 of
msgid ""
"Scale and skew are ignored. The returned poses contain only translation "
"and rotation."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_local_poses:8
#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_world_poses:8 of
msgid ""
"Indices of prims to get poses for. Defaults to None, in which case poses "
"are retrieved for all prims in the view."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_world_poses:11 of
msgid ""
"- positions: Torch tensor of shape (M, 3) containing world-space "
"positions (x, y, z),   where M is the number of prims queried. - "
"orientations: Torch tensor of shape (M, 4) containing world-space "
"quaternions (w, x, y, z)"
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_world_poses:13 of
msgid ""
"positions: Torch tensor of shape (M, 3) containing world-space positions "
"(x, y, z), where M is the number of prims queried."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_world_poses:15 of
msgid ""
"orientations: Torch tensor of shape (M, 4) containing world-space "
"quaternions (w, x, y, z)"
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_local_poses
#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_world_poses of
msgid "Return type"
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_local_poses:3 of
msgid ""
"This method retrieves the position and orientation of each prim in local "
"space (relative to their parent prims). These are the raw transform "
"values stored on each prim."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_local_poses:6 of
msgid ""
"Scale is ignored. The returned poses contain only translation and "
"rotation."
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_local_poses:11 of
msgid ""
"- translations: Torch tensor of shape (M, 3) containing local-space "
"translations (x, y, z),   where M is the number of prims queried. - "
"orientations: Torch tensor of shape (M, 4) containing local-space "
"quaternions (w, x, y, z)"
msgstr ""

#: isaaclab.sim.views.xform_prim_view.XformPrimView.get_local_poses:13 of
msgid ""
"translations: Torch tensor of shape (M, 3) containing local-space "
