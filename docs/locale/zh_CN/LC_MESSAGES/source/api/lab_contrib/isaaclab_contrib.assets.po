#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.collision_group:4 of
msgid ""
"``0``: local collision group (collides with other assets in the same "
"environment)."
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.debug_vis:1 of
msgid ""
"Whether to enable debug visualization for the asset. Defaults to "
"``False``."
msgstr ""

#: ../../docstring
#: isaaclab_contrib.assets.MultirotorCfg.articulation_root_prim_path:1 of
msgid ""
"Path to the articulation root prim under the :attr:`prim_path`. Defaults "
"to None, in which case the class will search for a prim with the USD "
"ArticulationRootAPI on it."
msgstr ""

#: ../../docstring
#: isaaclab_contrib.assets.MultirotorCfg.articulation_root_prim_path:4 of
msgid ""
"This path should be relative to the :attr:`prim_path` of the asset. If "
"the asset is loaded from a USD file, this path should be relative to the "
"root of the USD stage. For instance, if the loaded USD file at "
":attr:`prim_path` contains two articulations, one at `/robot1` and "
"another at `/robot2`, and you want to use `robot2`, then you should set "
"this to `/robot2`."
msgstr ""

#: ../../docstring
#: isaaclab_contrib.assets.MultirotorCfg.articulation_root_prim_path:9 of
msgid "The path must start with a slash (`/`)."
msgstr ""

#: ../../docstring
#: isaaclab_contrib.assets.MultirotorCfg.soft_joint_pos_limit_factor:1 of
msgid ""
"Fraction specifying the range of joint position limits (parsed from the "
"asset) to use. Defaults to 1.0."
msgstr ""

#: ../../docstring
#: isaaclab_contrib.assets.MultirotorCfg.soft_joint_pos_limit_factor:3 of
msgid ""
"The soft joint position limits are scaled by this factor to specify a "
"safety region within the simulated joint position limits. This isn't used"
" by the simulation, but is useful for learning agents to prevent the "
"joint positions from violating the limits, such as for termination "
"conditions."
msgstr ""

#: ../../docstring
#: isaaclab_contrib.assets.MultirotorCfg.soft_joint_pos_limit_factor:7 of
msgid ""
"The soft joint position limits are accessible through the "
":attr:`ArticulationData.soft_joint_pos_limits` attribute."
msgstr ""

#: ../../docstring
#: isaaclab_contrib.assets.MultirotorCfg.thruster_force_direction:1 of
msgid ""
"Default force direction in body-local frame for thrusters. Default is "
"``(0.0, 0.0, 1.0)``, which is upward along the Z-axis."
msgstr ""

#: ../../docstring
#: isaaclab_contrib.assets.MultirotorCfg.thruster_force_direction:4 of
msgid ""
"This 3D unit vector specifies the direction in which thrusters generate "
"force in the multirotor's body frame. For standard configurations:"
msgstr ""

#: ../../docstring
#: isaaclab_contrib.assets.MultirotorCfg.thruster_force_direction:7 of
msgid ""
"``(0.0, 0.0, 1.0)``: Thrusters push upward (Z-axis, typical for "
"quadcopters)"
msgstr ""

#: ../../docstring
#: isaaclab_contrib.assets.MultirotorCfg.thruster_force_direction:8 of
msgid "``(0.0, 0.0, -1.0)``: Thrusters push downward"
msgstr ""

#: ../../docstring
#: isaaclab_contrib.assets.MultirotorCfg.thruster_force_direction:9 of
msgid "``(1.0, 0.0, 0.0)``: Thrusters push forward (X-axis)"
msgstr ""

#: ../../docstring
#: isaaclab_contrib.assets.MultirotorCfg.thruster_force_direction:11 of
msgid ""
"This is used in conjunction with the allocation matrix to compute the "
"wrench produced by each thruster."
msgstr ""

#: ../../docstring
#: isaaclab_contrib.assets.MultirotorCfg.thruster_force_direction:14 of
msgid "Default: ``(0.0, 0.0, 1.0)`` (upward along Z-axis)"
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.allocation_matrix:1 of
msgid ""
"Allocation matrix for control allocation. Default is ``None``, which "
"means that the thrusters are not used for control allocation."
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.allocation_matrix:4 of
msgid ""
"This matrix maps individual thruster forces to the 6D wrench (force + "
"torque) applied to the multirotor's base link. It has shape ``(6, "
"num_thrusters)``:"
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.allocation_matrix:7 of
msgid "**Rows 0-2**: Force contributions in body frame (Fx, Fy, Fz)"
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.allocation_matrix:8 of
msgid "**Rows 3-5**: Torque contributions in body frame (Tx, Ty, Tz)"
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.allocation_matrix:10
#: of
msgid ""
"The allocation matrix encodes the geometric configuration of the "
"multirotor, including thruster positions, orientations, and moment arms."
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.allocation_matrix:23
#: of
msgid "Example for a quadcopter (4 thrusters in + configuration):"
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.allocation_matrix:27
#: of
msgid ""
"If ``None``, forces must be applied through other means. For typical "
"multirotor control, this should always be specified."
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.rotor_directions:1 of
msgid ""
"Sequence of rotor directions for each thruster. Default is ``None``, "
"which means that the rotor directions are not specified."
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.rotor_directions:4 of
msgid ""
"This specifies the spin direction of each rotor, which affects the "
"reaction torques generated. Values should be:"
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.rotor_directions:7 of
msgid "``1``: Counter-clockwise (CCW) rotation"
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.rotor_directions:8 of
msgid "``-1``: Clockwise (CW) rotation"
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.rotor_directions:10 of
msgid ""
"For a quadcopter, a typical configuration is alternating directions to "
"cancel reaction torques during hover: ``[1, -1, 1, -1]``."
msgstr ""

#: ../../docstring isaaclab_contrib.assets.MultirotorCfg.rotor_directions:25 of
msgid ""
"The length must match the total number of thrusters defined in the "
"actuators configuration, otherwise a ``ValueError`` will be raised during"
" initialization."
msgstr ""

