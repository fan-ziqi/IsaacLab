#: isaaclab_contrib.assets.multirotor.multirotor.Multirotor.write_data_to_sim:3
#: of
msgid "This method performs the following operations in sequence:"
msgstr ""

#: isaaclab_contrib.assets.multirotor.multirotor.Multirotor.write_data_to_sim:5
#: of
msgid ""
"**Apply actuator models**: Process thrust targets through thruster "
"actuator models to compute actual thrust values considering dynamics "
"(rise/fall times) and constraints (thrust limits)."
msgstr ""

#: isaaclab_contrib.assets.multirotor.multirotor.Multirotor.write_data_to_sim:9
#: of
msgid ""
"**Combine thrusts into wrench**: Use the allocation matrix to convert "
"individual thruster forces into a combined 6D wrench (force + torque) "
"vector."
msgstr ""

#: isaaclab_contrib.assets.multirotor.multirotor.Multirotor.write_data_to_sim:12
#: of
msgid ""
"**Apply to simulation**: Apply the combined wrench to the base link of "
"the multirotor in the PhysX simulation."
msgstr ""

#: isaaclab_contrib.assets.multirotor.multirotor.Multirotor.write_data_to_sim:15
