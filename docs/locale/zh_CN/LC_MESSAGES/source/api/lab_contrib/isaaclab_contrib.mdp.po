msgid "Optional automatic offset computation based on hover thrust"
msgstr ""

#: isaaclab_contrib.mdp.actions.thrust_actions.ThrustAction:17 of
msgid "Action clipping for safety and constraint enforcement"
msgstr ""

#: isaaclab_contrib.mdp.actions.thrust_actions.ThrustAction:18 of
