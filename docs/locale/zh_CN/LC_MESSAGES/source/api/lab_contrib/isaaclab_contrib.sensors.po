#: isaaclab_contrib.sensors.tacsl_sensor.visuotactile_sensor.VisuoTactileSensor:3
#: of
msgid ""
"This sensor provides: 1. Camera-based tactile sensing: depth images from "
"tactile surface 2. Force field tactile sensing: Penalty-based normal and "
"shear forces using SDF queries"
msgstr ""

#: isaaclab_contrib.sensors.tacsl_sensor.visuotactile_sensor.VisuoTactileSensor:7
#: of
msgid "The sensor can be configured to use either or both sensing modalities."
msgstr ""

#: isaaclab_contrib.sensors.tacsl_sensor.visuotactile_sensor.VisuoTactileSensor:16
#: of
msgid "**Computation Pipeline:**"
msgstr ""

#: isaaclab_contrib.sensors.tacsl_sensor.visuotactile_sensor.VisuoTactileSensor:10
#: of
msgid ""
"Camera-based sensing computes depth differences from a nominal (no-"
"contact) baseline and processes them through the tac-sl GelSight renderer"
" to produce realistic tactile images."
msgstr ""

#: isaaclab_contrib.sensors.tacsl_sensor.visuotactile_sensor.VisuoTactileSensor:13
#: of
#, python-brace-format
msgid ""
"Force field sensing queries Signed Distance Fields (SDF) to compute "
"penetration depths, then applies penalty-based spring-damper models "
"(:math:`F_n = k_n \\cdot \\text{depth}`, :math:`F_t = \\min(k_t \\cdot "
"\\|v_t\\|, \\mu \\cdot F_n)`) to compute normal and shear forces at "
"discrete tactile points."
msgstr ""

