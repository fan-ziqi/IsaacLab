msgid "``NV_DEVICE_PROFILE``"
msgstr "``NV_DEVICE_PROFILE``"

#: source/features/isaac_teleop.rst:1178
msgid "``NV_CXR_ENABLE_PUSH_DEVICES``"
msgstr "``NV_CXR_ENABLE_PUSH_DEVICES``"

#: source/features/isaac_teleop.rst:1179
msgid "``NV_ENABLE_POSE_WAIT``"
msgstr "``NV_ENABLE_POSE_WAIT``"

#: source/features/isaac_teleop.rst:1180
