msgstr "``extra`` 字段"

#: source/features/multi_gpu.rst:181
msgid "Meaning"
msgstr "含义"

#: source/features/multi_gpu.rst:182
msgid "``world_size``, ``local_world_size``, ``num_nodes``"
msgstr "``world_size``, ``local_world_size``, ``num_nodes``"

